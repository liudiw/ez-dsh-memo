{
  "name": "ez-dsh-memo",
  "version": "0.1.0",
  "type": "module",
  "description": "A sticky-note wall for DeepSeek Harness: markdown notes, categories, reminders, wiki links, images, and fast-note-sync mirroring.",
  "icon": "./icon.svg",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "sync.js",
    "cordis.patch.yml",
    "icon.svg",
    "icons/*.png",
    "locale/*.json",
    "LICENSE",
    "README.md",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "notes",
    "memo",
    "sticky-notes",
    "wiki-links",
    "reminder"
  ],
  "license": "MIT",
  "author": "liudiw",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liudiw/ez-dsh-memo.git"
  },
  "homepage": "https://github.com/liudiw/ez-dsh-memo#readme",
  "bugs": {
    "url": "https://github.com/liudiw/ez-dsh-memo/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
